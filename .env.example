# ChangeGuardian AI - environment configuration
# Copy to .env for local development. On the server these are set in the
# Dokploy Environment tab and never committed.

# ---------------------------------------------------------------- LLM (agent 7)
# Any OpenAI-compatible endpoint works. Agents 1-6 are deterministic and run
# without an LLM at all, so leaving LLM_API_KEY unset is a supported mode -
# explanations simply fall back to the rule-based text.

# Groq free tier - the deployed default. Key: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=

# Google AI Studio free tier - more generous daily quota than Groq.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash-lite

# Fully local, no data leaves the machine. Needs `ollama serve` running.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b

LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.2

# Circuit breaker: after N consecutive failures, stop calling the provider for
# the cooldown period and serve rule-based explanations instead. Cooldown
# doubles on each failed retry probe, capped at LLM_MAX_COOLDOWN_SECONDS.
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=60
LLM_MAX_COOLDOWN_SECONDS=600

# ------------------------------------------------------------------- API edge
RATE_LIMIT_PER_MINUTE=5
